
config homeproxy 'infra'
	option __warning 'DO NOT EDIT THIS SECTION, OR YOU ARE ON YOUR OWN!'
	option common_port '22,53,80,143,443,465,853,873,993,995,5222,8080,8443,9418'
	option mixed_port '5330'
	option redirect_port '5331'
	option tproxy_port '5332'
	option dns_port '5333'
	option ntp_server 'time.apple.com'
	option sniff_override '1'
	option tun_name 'singtun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	option table_mark '100'
	option self_mark '100'
	option tproxy_mark '101'
	option tun_mark '102'

config homeproxy 'migration'
	option crontab '1'

config homeproxy 'server'
	option enabled '1'
	option log_level 'info'

config homeproxy 'config'
	option routing_mode 'custom'
	option proxy_mode 'redirect_tproxy'
	option ipv6_support '0'
	option log_level 'info'
	option routing_port 'common'

config homeproxy 'control'
	option lan_proxy_mode 'disabled'

config homeproxy 'routing'
	option sniff_override '1'
	option default_outbound 'direct-out'
	option udp_timeout '300'
	option bypass_cn_traffic '1'
	option default_outbound_dns 'bootstrap'

config homeproxy 'dns'
	option dns_strategy 'prefer_ipv4'
	option default_server 'hph_google_hdns'
	option default_strategy 'ipv4_only'

config homeproxy 'subscription'
	option auto_update '0'
	option allow_insecure '0'
	option packet_encoding 'xudp'
	option update_via_proxy '0'
	option filter_nodes 'disabled'
	list subscription_url 'subscription.com'

config routing_node 'HK'
	option label 'HK'
	option enabled '0'
	option node 'urltest'

config routing_node 'JP'
	option label 'JP'
	option enabled '0'
	option node 'urltest'

config routing_node 'TW'
	option label 'TW'
	option enabled '1'
	option node 'urltest'

config routing_node 'US'
	option label 'US'
	option enabled '1'
	option node 'urltest'
	list urltest_nodes 'hello_world'
	list urltest_nodes 'hello_world_ai'

config routing_node 'SG'
	option label 'SG'
	option enabled '1'
	option node 'urltest'

config routing_rule 'Apple'
	option label 'Apple'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_apple'
	option action 'route'
	option outbound 'direct-out'

config routing_rule 'custom_direct'
	option label 'custom_direct'
	option enabled '1'
	option mode 'default'
	option action 'route'
	option outbound 'direct-out'
	list domain_suffix 'dmit.io'

config routing_rule 'custome_proxy'
	option label 'custom_proxy'
	option enabled '1'
	option mode 'default'
	option action 'route'
	option outbound 'active'
	list domain 'community.oneplus.com'
	list domain 'speed.cloudflare.com'
	list domain 'www.speedtest.net'
	list domain_suffix 'asuswrt-merlin.net'
	list domain_suffix 'alibaba.com'
	list domain_suffix 'leetcode.com'
	list domain_suffix 'justmysocks3.net'
	list domain_suffix 'bing.com'
	list domain_suffix 'fast.com'
	list domain_suffix 'leaseweb.net'
	list domain_suffix 'v2rayn.org'
	list domain_suffix 'steampowered.com'
	list domain_suffix 'steamcommunity.com'
	list ip_cidr '1.0.0.1/32'
	list ip_cidr '1.1.1.1/32'
	list ip_cidr '2606:4700:4700::1111/128'
	list ip_cidr '2606:4700:4700::1001/128'

config routing_rule 'ChatGPT'
	option label 'ChatGPT'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_openai'
	option outbound 'aiOut'
	option action 'route'

config routing_rule 'Gemini'
	option label 'Gemini'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_gemini'
	option action 'route'
	option outbound 'aiOut'

config routing_rule 'AI'
	option label 'AI'
	option enabled '1'
	option mode 'default'
	option outbound 'aiOut'
	option action 'route'
	list rule_set 'hph_rule_ucategory_hai_hglobal'

config routing_rule 'Netflix'
	option label 'Netflix'
	option enabled '1'
	option mode 'default'
	option outbound 'SG'
	list rule_set 'rule_netflix'
	list rule_set 'rule_netflix_ip'
	option ip_version '4'
	option action 'route'

config routing_rule 'DisneyPlus'
	option label 'DisneyPlus'
	option enabled '1'
	option mode 'default'
	option outbound 'SG'
	list rule_set 'rule_disney'
	option ip_version '4'
	option action 'route'

config dns_rule 'reject'
	option label 'reject'
	option enabled '1'
	option mode 'default'
	option action 'reject'
	option reject_method 'default'
	list domain 'gu-ecom.com'
	list domain_suffix 'gu-ecom.com'
	list domain_suffix 'codelife.cc'
	list domain_suffix 'itab.link'
	list rule_set 'rule_ads'
	list rule_set 'rule_adobe'

config dns_rule 'node'
	option label 'node'
	option enabled '1'
	option mode 'default'
	option action 'route'
	option server 'bootstrap'
	list domain_suffix 'subscription.com'
	list domain_suffix 'your_sub_address.com'
	option domain_strategy 'ipv4_only'

config dns_rule 'sitecn'
	option label 'sitecn'
	option enabled '1'
	option mode 'default'
	option server 'bootstrap'
	option action 'route'
	option ip_version '4'
	list rule_set 'rule_geosite_cn'
	list rule_set 'rule_categorygames_and_cn'
	list rule_set 'rule_apple'

config dns_rule 'aitools'
	option label 'aitools'
	option enabled '1'
	option mode 'default'
	option action 'route'
	option server 'hph_google_hdns'
	option ip_version '4'
	list domain_suffix 'bing.com'
	list domain 'speed.cloudflare.com'
	list domain 'www.speedtest.net'
	list rule_set 'rule_openai'
	list rule_set 'rule_gemini'
	list rule_set 'hph_rule_ucategory_hai_hglobal'
	list rule_set 'rule_bing'

config routing_rule 'github'
	option label 'github'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_github'
	option action 'route'
	option outbound 'active'

config routing_rule 'Steam'
	option label 'Steam'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_steam'
	option action 'route'
	option outbound 'direct-out'

config routing_rule 'Telegram'
	option label 'Telegram'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_telegram'
	list rule_set 'rule_telgram_ip'
	option action 'route'
	option outbound 'active'

config routing_rule 'hph_Instant_hMessaging'
	option label 'Instant-Messaging'
	option enabled '1'
	option mode 'default'
	list rule_set 'hph_rule_ucategory_hcommunication'
	option action 'route'
	option outbound 'active'

config routing_rule 'Bing'
	option label 'Bing'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_bing'
	option action 'route'
	option outbound 'active'

config routing_rule 'GFWList'
	option label 'GFWList'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_gfw'
	option action 'route'
	option outbound 'active'

config dns_server 'alidns'
	option label 'alidns'
	option enabled '1'
	option type 'https'
	option server 'dns.alidns.com'
	option outbound 'direct-out'

config dns_rule 'disney_out'
	option label 'disney_out'
	option enabled '1'
	option mode 'default'
	option action 'route'
	option server 'hph_streamingMedia_hdns'
	list rule_set 'rule_disney'

config dns_server 'bootstrap'
	option label 'bootstrap'
	option enabled '1'
	option type 'udp'
	option server '192.168.50.1'
	option outbound 'direct-out'

config node 'hello_world_ai'
	option label 'hello_world_ai'
	option type 'vless'
	option address 'hello_world.com'
	option port '443'
	option uuid 'asa-as-425ssf-f571e9725829'
	option vless_flow 'xtls-rprx-vision'
	option tls '1'
	option tls_sni 'hello_world.com'
	option tls_utls 'chrome'
	option tls_reality '1'
	option tls_reality_public_key 'tls_reality_public_key'
	option tls_reality_short_id 'tls_reality_short_id'

config node 'hello_world'
	option label 'hello_world'
	option type 'vless'
	option address 'hello_world.com'
	option port '443'
	option uuid 'asa-as-425ssf-f571e9725829'
	option vless_flow 'xtls-rprx-vision'
	option tls '1'
	option tls_sni 'hello_world.com'
	option tls_utls 'chrome'
	option tls_reality '1'
	option tls_reality_public_key 'tls_reality_public_key'
	option tls_reality_short_id 'tls_reality_short_id'

config routing_node 'active'
	option label 'active'
	option enabled '1'
	option node 'hello_world'
	option domain_resolver 'bootstrap'

config routing_node 'aiOut'
	option label 'aiOut'
	option enabled '1'
	option node 'hello_world_ai'
	option bind_interface 'br-lan'

config dns_server 'hph_google_hdns'
	option label 'google-dns'
	option enabled '1'
	option type 'https'
	option server '8.8.8.8'
	option outbound 'active'
	option server_port '443'

config dns_server 'hph_streamingMedia_hdns'
	option label 'streamingMedia-dns'
	option enabled '1'
	option type 'https'
	option server '8.8.8.8'
	option outbound 'SG'
	option server_port '443'

config dns_rule 'netflix_out'
	option label 'netflix_out'
	option enabled '1'
	option mode 'default'
	list rule_set 'rule_netflix'
	option action 'route'
	option server 'hph_streamingMedia_hdns'

