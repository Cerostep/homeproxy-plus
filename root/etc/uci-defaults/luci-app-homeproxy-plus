ucode "/etc/homeproxy_plus/scripts/migrate_config.uc" || exit 1

[ -f "/www/luci-static/resources/icons/loading.gif" ] && \
	sed -i "s,/loading.svg,/loading.gif,g" "/www/luci-static/resources/view/homeproxy_plus/status.js"

uci -q batch <<-EOF >"/dev/null"
	delete firewall.homeproxy_plus_pre

	delete firewall.homeproxy_plus_forward
	set firewall.homeproxy_plus_forward=include
	set firewall.homeproxy_plus_forward.type=nftables
	set firewall.homeproxy_plus_forward.path="/var/run/homeproxy_plus/fw4_forward.nft"
	set firewall.homeproxy_plus_forward.position="chain-pre"
	set firewall.homeproxy_plus_forward.chain="forward"

	delete firewall.homeproxy_plus_input
	set firewall.homeproxy_plus_input=include
	set firewall.homeproxy_plus_input.type=nftables
	set firewall.homeproxy_plus_input.path="/var/run/homeproxy_plus/fw4_input.nft"
	set firewall.homeproxy_plus_input.position="chain-pre"
	set firewall.homeproxy_plus_input.chain="input"

	delete firewall.homeproxy_plus_post
	set firewall.homeproxy_plus_post=include
	set firewall.homeproxy_plus_post.type=nftables
	set firewall.homeproxy_plus_post.path="/var/run/homeproxy_plus/fw4_post.nft"
	set firewall.homeproxy_plus_post.position="table-post"
	commit firewall
EOF

exit 0
